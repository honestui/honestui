{
  "name": "honestui",
  "version": "0.0.8",
  "description": "Build and manage Honest UI component libraries.",
  "license": "MIT",
  "homepage": "https://honestui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honestui/honestui.git",
    "directory": "package/honestui"
  },
  "bugs": {
    "url": "https://github.com/honestui/honestui/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./charts.css": "./dist/charts.css",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./logos": {
      "types": "./dist/logos.d.ts",
      "default": "./dist/logos.js"
    },
    "./shaders": {
      "types": "./dist/shaders.d.ts",
      "default": "./dist/shaders.js"
    },
    "./shaders.css": "./dist/shaders.css",
    "./vectors": {
      "types": "./dist/vectors.d.ts",
      "default": "./dist/vectors.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "honestui": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/mark-client-entries.mjs && node scripts/build-chart-styles.mjs",
    "sync:registry": "node scripts/copy-registry.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "lint": "eslint src registry/default/charts registry/default/ui/charts registry/default/shaders",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:artifact": "node scripts/verify-package-artifact.mjs",
    "verify:release": "npm run verify:registry && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:exports && npm run verify:artifact && npm audit",
    "prepack": "npm run verify:release"
  },
  "dependencies": {
    "@antfu/ni": "^25.0.0",
    "@babel/core": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/plugin-transform-typescript": "^7.27.1",
    "commander": "^14.0.0",
    "cosmiconfig": "^9.0.0",
    "dedent": "^1.6.0",
    "deepmerge": "^4.3.1",
    "diff": "^8.0.2",
    "echarts": "^6.1.0",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.1",
    "fuzzysort": "^3.1.0",
    "https-proxy-agent": "^7.0.6",
    "kleur": "^4.1.5",
    "love-ui": "^1.2.24",
    "motion": "^12.42.2",
    "node-fetch": "^3.3.2",
    "ogl": "^1.0.11",
    "open": "^11.0.0",
    "ora": "^8.2.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "prompts": "^2.4.2",
    "recast": "^0.23.11",
    "stringify-object": "^5.0.0",
    "tailwind-merge": "^3.0.1",
    "ts-morph": "^26.0.0",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/stringify-object": "^4.0.5",
    "eslint": "^9.39.5",
    "msw": "^2.11.6",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "type-fest": "^4.41.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}

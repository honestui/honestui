{
  "name": "honestui",
  "version": "0.2.3",
  "description": "Build and manage Honest UI component libraries.",
  "license": "MIT",
  "homepage": "https://honestui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honestui/honestui.git",
    "directory": "package/honestui"
  },
  "bugs": {
    "url": "https://github.com/honestui/honestui/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/src/charts.d.ts",
      "default": "./dist/charts.js"
    },
    "./charts.css": "./dist/charts.css",
    "./density.css": "./dist/density.css",
    "./icons": {
      "types": "./dist/src/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./logos": {
      "types": "./dist/src/logos.d.ts",
      "default": "./dist/logos.js"
    },
    "./shaders": {
      "types": "./dist/src/shaders.d.ts",
      "default": "./dist/shaders.js"
    },
    "./vectors": {
      "types": "./dist/src/vectors.d.ts",
      "default": "./dist/vectors.js"
    },
    "./package.json": "./package.json",
    "./ai": {
      "types": "./dist/src/ai.d.ts",
      "default": "./dist/ai.js"
    },
    "./prose": {
      "types": "./dist/src/prose.d.ts",
      "default": "./dist/prose.js"
    },
    "./genui": {
      "types": "./dist/src/genui.d.ts",
      "default": "./dist/genui.js"
    },
    "./genui/react": {
      "types": "./dist/src/genui-react.d.ts",
      "default": "./dist/genui-react.js"
    },
    "./genui/chat": {
      "types": "./dist/src/genui-chat.d.ts",
      "default": "./dist/genui-chat.js"
    },
    "./genui/server": {
      "types": "./dist/src/genui-server.d.ts",
      "default": "./dist/genui-server.js"
    },
    "./genui/server/openai": {
      "types": "./dist/src/genui-server-openai.d.ts",
      "default": "./dist/genui-server-openai.js"
    },
    "./genui/server/vercel": {
      "types": "./dist/src/genui-server-vercel.d.ts",
      "default": "./dist/genui-server-vercel.js"
    },
    "./genui/server/langgraph": {
      "types": "./dist/src/genui-server-langgraph.d.ts",
      "default": "./dist/genui-server-langgraph.js"
    },
    "./syntax": {
      "types": "./dist/src/syntax.d.ts",
      "default": "./dist/syntax.js"
    },
    "./syntax/browser": {
      "types": "./dist/src/syntax-browser.d.ts",
      "default": "./dist/syntax-browser.js"
    },
    "./syntax/react": {
      "types": "./dist/src/syntax-react.d.ts",
      "default": "./dist/syntax-react.js"
    },
    "./syntax/codemirror": {
      "types": "./dist/src/syntax-codemirror.d.ts",
      "default": "./dist/syntax-codemirror.js"
    },
    "./syntax/tailwind": {
      "types": "./dist/src/syntax-tailwind.d.ts",
      "default": "./dist/syntax-tailwind.js"
    },
    "./syntax/themes": {
      "types": "./dist/src/syntax-themes.d.ts",
      "default": "./dist/syntax-themes.js"
    },
    "./ai/*": {
      "types": "./dist/src/honest-ai/registry/ai/*.d.ts",
      "default": "./dist/ai/*.js"
    },
    "./prose.css": "./dist/prose.css",
    "./syntax.css": "./dist/syntax.css",
    "./ai.css": "./dist/ai.css",
    "./syntax/worker": "./dist/syntax-worker.js",
    "./genui/spec.json": "./dist/genui-spec.json",
    "./genui/chat-spec.json": "./dist/genui-chat-spec.json",
    "./ai/markdown-math": {
      "types": "./dist/src/honest-ai/registry/lib/markdown-math.d.ts",
      "default": "./dist/markdown-math.js"
    },
    "./ai/markdown-shiki": {
      "types": "./dist/src/honest-ai/registry/lib/markdown-shiki.d.ts",
      "default": "./dist/markdown-shiki.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "bin": {
    "honestui": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/syntax-worker.js"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && npm run build:types && node scripts/mark-client-entries.mjs && node scripts/build-chart-styles.mjs && node scripts/copy-density-styles.mjs && node scripts/build-ai.mjs",
    "build:types": "tsc --project tsconfig.build.json",
    "sync:registry": "node scripts/copy-registry.mjs",
    "verify:registry": "node scripts/verify-registry.mjs",
    "lint": "eslint src registry/default/charts registry/default/ui/charts registry/default/shaders",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:artifact": "node scripts/verify-package-artifact.mjs",
    "verify:release": "npm run verify:ai && npm run verify:registry && npm run lint && npm run typecheck && npm test && npm run build && npm run verify:exports && npm run verify:artifact && npm audit",
    "prepack": "npm run verify:release",
    "verify:ai": "node scripts/verify-ai-source.mjs"
  },
  "dependencies": {
    "@antfu/ni": "^25.0.0",

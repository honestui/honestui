    "date-fns": "^4.4.0",
    "maplibre-gl": "6.11.2",
    "next-themes": "0.4.6",
    "react-day-picker": "9.14.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "zustand": "5.0.14",

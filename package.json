{
  "name": "honestui-site",
  "private": true,
  "version": "0.2.4",
  "description": "Accessible React components, animated interactions, shaders, charts, and icons from Honest UI.",
  "license": "MIT",
  "homepage": "https://honestui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honestui/honestui.git"
  },
  "bugs": {
    "url": "https://github.com/honestui/honestui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js",
      "require": "./dist/charts.cjs"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "fumadocs-mdx && node scripts/ai/copy-maplibre-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build:package": "npm --prefix package/honestui run build",
    "pack:package": "npm --prefix package/honestui pack",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint .",
    "verify:docs": "node scripts/verify-docs.mjs && node scripts/verify-component-docs.mjs && node scripts/verify-theme-docs.mjs && node scripts/ai/verify-docs.mjs",
    "verify:component-docs": "node scripts/verify-component-docs.mjs",
    "verify:theme-docs": "node scripts/verify-theme-docs.mjs",
    "verify:tokens": "node scripts/verify-token-prefix.mjs",
    "verify:site": "npm run ai:check && npm run lint && npm run typecheck && npm run verify:docs && npm run verify:ui && npm run verify:tokens && npm run build",
    "verify:release": "npm run verify:site && npm run test:e2e && npm audit",
    "verify:production-docs": "node scripts/verify-production-docs.mjs",
    "verify:production-registry": "node scripts/verify-production-registry.mjs",
    "registry:animated": "node scripts/generate-animated-index.mjs",
    "registry:charts": "node scripts/generate-chart-index.mjs",
    "registry:shaders": "node scripts/generate-shader-index.mjs",
    "prepack": "npm run build:package",
    "verify:ui": "node scripts/verify-ui-parity.mjs",
    "ai:index": "node scripts/ai/generate-registry-index.mjs",
    "ai:sync": "node scripts/ai/sync-package.mjs",
    "ai:check": "node scripts/ai/sync-package.mjs --check && node scripts/ai/generate-generative-spec.mjs --check && node scripts/ai/generate-prose-tailwind.mjs --check && node scripts/ai/generate-syntax-tailwind.mjs --check && node scripts/ai/generate-syntax-palettes.mjs --check && node scripts/ai/copy-maplibre-worker.mjs --check && node scripts/ai/verify-generative-standalone.mjs",
    "ai:spec": "node scripts/ai/generate-generative-spec.mjs",
    "ai:prose": "node scripts/ai/generate-prose-tailwind.mjs",
    "ai:syntax": "node scripts/ai/generate-syntax-tailwind.mjs && node scripts/ai/generate-syntax-palettes.mjs",
    "ai:syntax:build": "node scripts/ai/build-prose-syntax.mjs",
    "ai:syntax:verify": "node scripts/ai/verify-prose-syntax.mjs",
    "ai:maps": "node scripts/ai/copy-maplibre-worker.mjs",
    "ai:verify-package": "node scripts/ai/verify-honestui-package.mjs",
    "test:ai": "vitest run",
    "test:ai:node": "esbuild tests/ai/markdown.test.tsx --bundle --platform=node --format=esm --packages=external --outfile=.next/tests/markdown.test.mjs && node --test .next/tests/markdown.test.mjs && esbuild tests/ai/prose-syntax.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.next/tests/prose-syntax.test.mjs && node --test .next/tests/prose-syntax.test.mjs"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.3",
    "@base-ui/react": "^1.6.0",
    "@carbon/icons-react": "^11.84.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@gsap/react": "^2.1.2",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@langchain/core": "^1.2.17",
    "@lezer/highlight": "1.2.5",
    "@mantine/hooks": "^9.4.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@shikijs/transformers": "^4.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@vercel/analytics": "^2.0.1",
    "ai": "7.0.138",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "6.0.2",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "eve": "^0.77.0",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-ui": "^16.12.1",
    "gsap": "^3.15.1",
    "katex": "0.16.47",
    "maplibre-gl": "6.11.2",
    "motion": "^12.42.2",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "openai": "6.22.0",
    "postprocessing": "^6.39.4",
    "react-day-picker": "^10.0.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shadcn": "^4.15.0",
    "shiki": "4.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "ts-morph": "^26.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/culori": "^4.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^28.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
